//@version=6
// PBD (インパルス後レンジ) × 週間 VAH/VAL 逆張り [3935P] — ストラテジー版（BT用）
// 仕様: 4H足でインパルス→レンジを検出し、レンジ端が確定済み週VP(VAH/VAL)と重なった時だけ
//       15分足の確定足で反発を判定してシグナルを出す。
// 注意: VPはチャート足のOHLCVから近似計算（TradingView内蔵VPの下位足計算とは数値が一致しない）。
//       VAH/VALは「確定済みの過去週」のみ使用（形成中の今週分は使わない＝リペイントなし）。
// 手数料・スリッページ・証拠金は銘柄に合わせて必ず変更すること（下記は仮値）
strategy("PBD × Weekly VA Reversal Strategy [3935P]", shorttitle = "PBD-VA-S [3935P]", overlay = true, max_lines_count = 500, max_labels_count = 500,
     initial_capital = 1000000, currency = currency.NONE, commission_type = strategy.commission.percent, commission_value = 0.01,
     slippage = 2, margin_long = 10, margin_short = 10, pyramiding = 0, calc_on_every_tick = false)

// ───────── 入力 ─────────
const string G_VP  = "ボリュームプロファイル"
const string G_HTF = "環境認識（上位足）"
const string G_TRG = "トリガー（執行足）"
const string G_RSK = "リスク管理"
const string G_FLT = "見送りフィルター"
const string G_VIS = "表示設定"

i_vpPeriod      = input.timeframe("W", "VP期間", group = G_VP, tooltip = "VPを集計する期間。動画は週(W)。")
i_vpValueArea   = input.float(70.0, "Value Area %", minval = 10, maxval = 99, group = G_VP)
i_vpRows        = input.int(60, "価格ビン数", minval = 10, maxval = 300, group = G_VP, tooltip = "期間の高値〜安値を何分割して出来高を集計するか")
i_vpWeeks       = input.int(2, "参照する過去期間数", minval = 1, maxval = 4, group = G_VP, tooltip = "1=先週のみ / 2=先週+2週前（動画で2週前の線が効いた例あり）")

i_htf           = input.timeframe("240", "上位足", group = G_HTF)
i_impulsePeriod = input.int(20, "インパルス判定期間(本)", minval = 2, group = G_HTF, tooltip = "レンジ直前のこの本数で、終値の純変化がATR×倍率以上ならインパルス")
i_impulseMult   = input.float(3.0, "インパルス ATR倍率", minval = 0.5, step = 0.5, group = G_HTF)
i_rangeLen      = input.int(12, "レンジ判定期間(本)", minval = 3, group = G_HTF, tooltip = "直近この本数の高値-安値幅でレンジを判定（4H×12本＝2日）")
i_rangeMult     = input.float(3.0, "レンジ幅上限 ATR倍率", minval = 0.5, step = 0.5, group = G_HTF)
i_maxRetrace    = input.float(0.5, "レンジ内の最大押し戻し率", minval = 0.1, maxval = 1.0, step = 0.05, group = G_HTF, tooltip = "インパルス幅に対しレンジ側へ戻した割合の上限。超えたら反転とみなし除外")
i_htfAtrLen     = input.int(50, "上位足 ATR期間", minval = 5, group = G_HTF)

i_atrLen        = input.int(14, "執行足 ATR期間", minval = 1, group = G_TRG)
i_rangeTolerance = input.float(1.0, "重なり許容 ATR倍率", minval = 0.1, step = 0.1, group = G_TRG, tooltip = "レンジ端とVAH/VALの距離、およびタッチ判定の許容幅（執行足ATR基準）")
i_setupMaxBars  = input.int(192, "セットアップ有効期限(本)", minval = 10, group = G_TRG, tooltip = "15分足192本＝約2日")
i_maxSignals    = input.int(1, "1セットアップ当たり最大シグナル数", minval = 1, maxval = 5, group = G_TRG)

i_slBuffer      = input.float(1.5, "SLバッファ ATR倍率", minval = 0.1, step = 0.1, group = G_RSK, tooltip = "SL = max(VA線, シグナル足の高値/安値) ± ATR×倍率")
i_minRR         = input.float(1.0, "最低RR", minval = 0.0, step = 0.1, group = G_RSK, tooltip = "TP(インパルス起点)までの距離 / SLまでの距離 がこれ未満なら見送り")
i_riskPercent   = input.float(1.0, "1トレードのリスク %", minval = 0.1, maxval = 5.0, step = 0.1, group = G_RSK, tooltip = "口座資金に対する1トレードの最大損失。数量 = 資金×% ÷ (|エントリー−SL|×pointvalue)")

i_useBlackout   = input.bool(true, "エントリー禁止時間帯を使う", group = G_FLT)
i_blackoutSess  = input.session("2100-2359", "禁止時間帯", group = G_FLT, tooltip = "経済指標カレンダーの代替。米指標発表時間帯の目安")
i_blackoutTz    = input.string("Asia/Tokyo", "タイムゾーン", group = G_FLT)
i_blackoutFri   = input.bool(true, "金曜のみ適用", group = G_FLT, tooltip = "OFFで毎日適用")

i_showPrev2     = input.bool(true, "2週前のVAH/VALも表示", group = G_VIS)
i_showLevels    = input.bool(true, "シグナル時にSL/TPラインを表示", group = G_VIS)

if timeframe.in_seconds() >= timeframe.in_seconds(i_htf)
    runtime.error("チャート足は上位足より短くしてください（推奨: 15分足）")

// ───────── 関数 ─────────
// 期間内バーのOHLCVから出来高プロファイルを作り [VAH, VAL] を返す
calcValueArea(array<float> his, array<float> los, array<float> vols, int rows, float vaPct) =>
    float vah = na
    float val = na
    int n = his.size()
    if n > 0
        float top = his.max()
        float bot = los.min()
        float step = (top - bot) / rows
        if step > 0
            array<float> prof = array.new_float(rows, 0.0)
            for i = 0 to n - 1
                int b0 = math.min(math.floor((los.get(i) - bot) / step), rows - 1)
                int b1 = math.min(math.floor((his.get(i) - bot) / step), rows - 1)
                float per = vols.get(i) / (b1 - b0 + 1)
                for b = b0 to b1
                    prof.set(b, prof.get(b) + per)
            float total = prof.sum()
            if total > 0
                int pocIdx = prof.indexof(prof.max())
                float acc = prof.get(pocIdx)
                int up = pocIdx
                int dn = pocIdx
                while acc < total * vaPct / 100.0 and (up < rows - 1 or dn > 0)
                    float vUp = up < rows - 1 ? prof.get(up + 1) : -1.0
                    float vDn = dn > 0 ? prof.get(dn - 1) : -1.0
                    if vUp >= vDn
                        up += 1
                        acc += vUp
                    else
                        dn -= 1
                        acc += vDn
                vah := bot + (up + 1) * step
                val := bot + dn * step
    [vah, val]

// 過去k期間のラインのうち target に最も近い値
nearestLevel(array<float> levels, float target, int k) =>
    float best = na
    int cnt = math.min(k, levels.size())
    if cnt > 0 and not na(target)
        for i = 0 to cnt - 1
            float lv = levels.get(i)
            if not na(lv) and (na(best) or math.abs(lv - target) < math.abs(best - target))
                best := lv
    best

// 上位足: インパルス→レンジ判定。[1]で確定足のみ返す（lookahead_onと組で非リペイント）
htfSetup() =>
    float atrH    = ta.atr(i_htfAtrLen)
    float rHi     = ta.highest(high, i_rangeLen)
    float rLo     = ta.lowest(low, i_rangeLen)
    float impEnd  = close[i_rangeLen]
    float net     = impEnd - close[i_rangeLen + i_impulsePeriod]
    float atrRef  = atrH[i_rangeLen]
    float origLo  = ta.lowest(low, i_impulsePeriod + 1)[i_rangeLen]
    float origHi  = ta.highest(high, i_impulsePeriod + 1)[i_rangeLen]
    bool isRange  = (rHi - rLo) <= i_rangeMult * atrH
    bool impUp    = net >= i_impulseMult * atrRef
    bool impDn    = -net >= i_impulseMult * atrRef
    bool holdUp   = (impEnd - rLo) <= i_maxRetrace * (impEnd - origLo)
    bool holdDn   = (rHi - impEnd) <= i_maxRetrace * (origHi - impEnd)
    bool shortSet = isRange and impUp and holdUp
    bool longSet  = isRange and impDn and holdDn
    [shortSet[1], longSet[1], rHi[1], rLo[1], origLo[1], origHi[1]]

// ───────── 週間VP（確定済み期間のみ） ─────────
var array<float> wHi  = array.new_float()
var array<float> wLo  = array.new_float()
var array<float> wVol = array.new_float()
var array<float> vahHist = array.new_float()
var array<float> valHist = array.new_float()

bool newPeriod = timeframe.change(i_vpPeriod)
if newPeriod and wHi.size() > 0
    [vah0, val0] = calcValueArea(wHi, wLo, wVol, i_vpRows, i_vpValueArea)
    vahHist.unshift(vah0)
    valHist.unshift(val0)
    if vahHist.size() > 4
        vahHist.pop()
        valHist.pop()
    wHi.clear()
    wLo.clear()
    wVol.clear()
wHi.push(high)
wLo.push(low)
wVol.push(nz(volume))

float vah1 = vahHist.size() > 0 ? vahHist.get(0) : na
float val1 = valHist.size() > 0 ? valHist.get(0) : na
float vah2 = vahHist.size() > 1 ? vahHist.get(1) : na
float val2 = valHist.size() > 1 ? valHist.get(1) : na

// ───────── 上位足 & 執行足計算（グローバルスコープ） ─────────
[htfShort, htfLong, rHi, rLo, origLo, origHi] = request.security(syminfo.tickerid, i_htf, htfSetup(), lookahead = barmerge.lookahead_on)
float atr = ta.atr(i_atrLen)
float tol = i_rangeTolerance * atr
float buf = i_slBuffer * atr

float vahNear = nearestLevel(vahHist, rHi, i_vpWeeks)
float valNear = nearestLevel(valHist, rLo, i_vpWeeks)
bool shortSetupOk = htfShort and not na(vahNear) and math.abs(rHi - vahNear) <= tol
bool longSetupOk  = htfLong and not na(valNear) and math.abs(rLo - valNear) <= tol
// 立ち上がりのみ採用（無効化直後に同じ上位足セットアップで再点灯させない）
bool shortSetupNow = shortSetupOk and not shortSetupOk[1]
bool longSetupNow  = longSetupOk and not longSetupOk[1]

bool inBlackoutSess = not na(time(timeframe.period, i_blackoutSess, i_blackoutTz))
bool isFriday = dayofweek(time, i_blackoutTz) == dayofweek.friday
bool blackout = i_useBlackout and inBlackoutSess and (not i_blackoutFri or isFriday)

// ───────── セットアップ状態 ─────────
var bool  sAct = false
var float sZone = na
var float sTP = na
var int   sBar = na
var int   sCnt = 0
var bool  lAct = false
var float lZone = na
var float lTP = na
var int   lBar = na
var int   lCnt = 0

// トリガー（前バーまでの状態で判定）
bool shortTouch = sAct and high >= sZone - tol and close < sZone and close < open
bool longTouch  = lAct and low <= lZone + tol and close > lZone and close > open
float shortSL = math.max(sZone, high) + buf
float longSL  = math.min(lZone, low) - buf
float shortRR = shortSL > close ? (close - sTP) / (shortSL - close) : 0.0
float longRR  = close > longSL ? (lTP - close) / (close - longSL) : 0.0
bool shortSignal = strategy.position_size == 0 and shortTouch and sCnt < i_maxSignals and sTP < close and shortRR >= i_minRR and not blackout and barstate.isconfirmed
bool longSignal  = strategy.position_size == 0 and longTouch and lCnt < i_maxSignals and lTP > close and longRR >= i_minRR and not blackout and barstate.isconfirmed

if shortSignal
    sCnt += 1
if longSignal
    lCnt += 1

// 無効化: 実体がVA線+バッファを抜けて確定 / TP到達 / 期限切れ
if sAct and (close > sZone + buf or low <= sTP or bar_index - sBar > i_setupMaxBars)
    sAct := false
if lAct and (close < lZone - buf or high >= lTP or bar_index - lBar > i_setupMaxBars)
    lAct := false

// 新規セットアップ
if shortSetupNow and not sAct
    sAct  := true
    sZone := vahNear
    sTP   := origLo
    sBar  := bar_index
    sCnt  := 0
if longSetupNow and not lAct
    lAct  := true
    lZone := valNear
    lTP   := origHi
    lBar  := bar_index
    lCnt  := 0

// ───────── 描画 ─────────
p1h = plot(vah1, "VAH(先週)", color = color.new(color.red, 0), linewidth = 2, style = plot.style_stepline)
p1l = plot(val1, "VAL(先週)", color = color.new(color.blue, 0), linewidth = 2, style = plot.style_stepline)
fill(p1h, p1l, color = color.new(color.purple, 90), title = "Value Area(先週)")
plot(i_showPrev2 ? vah2 : na, "VAH(2週前)", color = color.new(color.red, 60), style = plot.style_stepline)
plot(i_showPrev2 ? val2 : na, "VAL(2週前)", color = color.new(color.blue, 60), style = plot.style_stepline)
plot(sAct ? sZone : na, "売りゾーン", color = color.new(color.orange, 0), linewidth = 3, style = plot.style_linebr)
plot(lAct ? lZone : na, "買いゾーン", color = color.new(color.teal, 0), linewidth = 3, style = plot.style_linebr)

plotshape(longSignal, "PBD Long", shape.triangleup, location.belowbar, color.new(color.teal, 0), size = size.small, text = "L")
plotshape(shortSignal, "PBD Short", shape.triangledown, location.abovebar, color.new(color.orange, 0), size = size.small, text = "S")

if i_showLevels and shortSignal
    line.new(bar_index, shortSL, bar_index + 40, shortSL, color = color.red, style = line.style_dashed)
    line.new(bar_index, sTP, bar_index + 40, sTP, color = color.green, style = line.style_dashed)
    label.new(bar_index, high, "S  SL " + str.tostring(shortSL, format.mintick) + "\nTP " + str.tostring(sTP, format.mintick) + "\nRR " + str.tostring(shortRR, "#.##") + " / risk " + str.tostring(i_riskPercent) + "%", style = label.style_label_down, color = color.new(color.orange, 20), textcolor = color.white, size = size.small)
if i_showLevels and longSignal
    line.new(bar_index, longSL, bar_index + 40, longSL, color = color.red, style = line.style_dashed)
    line.new(bar_index, lTP, bar_index + 40, lTP, color = color.green, style = line.style_dashed)
    label.new(bar_index, low, "L  SL " + str.tostring(longSL, format.mintick) + "\nTP " + str.tostring(lTP, format.mintick) + "\nRR " + str.tostring(longRR, "#.##") + " / risk " + str.tostring(i_riskPercent) + "%", style = label.style_label_up, color = color.new(color.teal, 20), textcolor = color.white, size = size.small)

// ───────── 発注 ─────────
// 成行はシグナル足確定→次足始値で約定。SL/TPは発注時点で固定し、以後いじらない（動画のルール）
float riskCash = strategy.equity * i_riskPercent / 100.0
if shortSignal
    float q = riskCash / ((shortSL - close) * syminfo.pointvalue)
    strategy.entry("PBD S", strategy.short, qty = q)
    strategy.exit("PBD S X", "PBD S", stop = shortSL, limit = sTP)
if longSignal
    float q = riskCash / ((close - longSL) * syminfo.pointvalue)
    strategy.entry("PBD L", strategy.long, qty = q)
    strategy.exit("PBD L X", "PBD L", stop = longSL, limit = lTP)
